// Конфигурация за Cloudflare Workers.
// Адаптерът на Astro допълва автоматично main (worker entry) и assets binding-а
// по време на build (DEPLOY_TARGET=cloudflare npm run build).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moiata-kola",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],

  // Анонимни агрегирани броячи на проверките (вид/изход/държава, по ден).
  // Без номера, без IP — виж src/lib/checks/stats.ts. Dataset-ът се създава
  // сам при първия запис; заявки: SQL през Analytics Engine API.
  "analytics_engine_datasets": [{ "binding": "CHECK_STATS", "dataset": "check_stats" }]

  // Кеш на резултатите от проверки (по желание, но препоръчително в продукция).
  // Създайте namespace и разкоментирайте с реалното id:
  //   npx wrangler kv namespace create CHECK_CACHE
  // ,"kv_namespaces": [{ "binding": "CHECK_CACHE", "id": "<id от командата>" }]
}
