---
/**
 * Подписният елемент на сайта: вход като българска регистрационна табела
 * + резултати от проверките. Работи без регистрация, на всяко устройство.
 */
import { OFFICIAL_SOURCES } from "@/lib/site";

interface Props {
  /** Кои проверки прави този екземпляр (началната страница ползва и трите) */
  checks: ("vignette" | "insurance" | "inspection")[];
  buttonLabel?: string;
  id?: string;
}

const { checks, buttonLabel = "Провери", id = "plate-check" } = Astro.props;
---

<section
  class="card p-5 sm:p-8"
  data-plate-check
  data-checks={checks.join(",")}
  data-rta={OFFICIAL_SOURCES.rta.checkUrl}
  id={id}
>
  <form class="flex flex-col items-center gap-4" novalidate>
    <label class="sr-only" for={`${id}-input`}>Регистрационен номер</label>

    <div
      class="flex h-16 w-full max-w-sm items-stretch overflow-hidden rounded-lg border-2 border-ink/80 bg-white focus-within:border-accent sm:h-20"
    >
      <span
        class="flex w-10 shrink-0 flex-col items-center justify-center gap-1 bg-accent text-white sm:w-12"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="currentColor">
          {
            Array.from({ length: 12 }, (_, i) => {
              const a = (i / 12) * 2 * Math.PI;
              return <circle cx={12 + 8 * Math.sin(a)} cy={12 - 8 * Math.cos(a)} r="1.1" />;
            })
          }
        </svg>
        <span class="font-plate text-xs font-semibold tracking-wide sm:text-sm">BG</span>
      </span>
      <input
        id={`${id}-input`}
        name="plate"
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="10"
        placeholder="СВ 1234 АВ"
        class="font-plate w-full min-w-0 border-0 bg-transparent text-center text-3xl font-semibold tracking-[0.18em] text-ink uppercase outline-none placeholder:text-ink-faint/50 sm:text-4xl"
        required
      />
    </div>

    <button type="submit" class="btn-primary w-full max-w-sm text-base">
      {buttonLabel}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10m0 0L9.5 4.5M13 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="text-xs text-ink-faint" data-plate-error hidden></p>
  </form>

  <div class="mt-6 space-y-3 empty:mt-0" data-results aria-live="polite"></div>

  <p class="mt-4 text-center text-xs text-ink-faint" data-timestamp hidden></p>
</section>

<script>
  import { normalizePlate, isValidBgPlate, type CheckResult, type CheckKind } from "@/lib/checks/types";
  import { mountGtp } from "@/lib/checks/gtp-client";

  const LABELS: Record<CheckKind, string> = {
    vignette: "Винетка",
    insurance: "Гражданска отговорност",
    inspection: "ГТП (технически преглед)",
  };

  const INVALID_CTA: Record<CheckKind, { href: string; label: string }> = {
    vignette: { href: "/vinetka/kupi", label: "Купи винетка онлайн" },
    insurance: { href: "/grazhdanska-otgovornost/proverka#oferti", label: "Сравни оферти за ГО" },
    inspection: { href: "/gtp/cena", label: "Виж цените за ГТП" },
  };

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric" });

  function pill(cls: string, text: string) {
    return `<span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${cls}">${text}</span>`;
  }

  function renderResult(r: CheckResult, plate: string): string {
    const head = `<p class="text-sm font-medium text-ink-soft">${LABELS[r.kind]}</p>`;

    if (r.status === "ok" && r.valid) {
      const expiring = r.daysLeft !== undefined && r.daysLeft <= 7;
      return `
        <div class="card flex items-center justify-between gap-4 border-l-4 ${expiring ? "border-l-warn" : "border-l-ok"} p-4 sm:p-5" data-card="${r.kind}">
          <div class="min-w-0">
            ${head}
            <div class="mt-1.5 flex flex-wrap items-center gap-2">
              ${expiring ? pill("bg-warn-soft text-warn", "Изтича скоро") : pill("bg-ok-soft text-ok", "Валидна")}
              ${r.detail ? `<span class="text-xs text-ink-faint">${esc(r.detail)}</span>` : ""}
            </div>
            ${r.validTo ? `<p class="mt-2 text-sm text-ink-soft">Валидна до <strong class="text-ink">${fmtDate(r.validTo)}</strong></p>` : ""}
            ${expiring ? `<a href="${INVALID_CTA[r.kind].href}" class="mt-2 inline-block text-sm font-semibold text-accent hover:underline">${INVALID_CTA[r.kind].label} →</a>` : ""}
          </div>
          ${
            r.daysLeft !== undefined
              ? `<div class="shrink-0 text-center">
                   <p class="font-plate text-4xl font-semibold ${expiring ? "text-warn" : "text-ok"} sm:text-5xl">${r.daysLeft}</p>
                   <p class="text-xs text-ink-faint">${r.daysLeft === 1 ? "ден остава" : "дни остават"}</p>
                 </div>`
              : ""
          }
        </div>`;
    }

    if (r.status === "ok" && !r.valid) {
      const cta = INVALID_CTA[r.kind];
      return `
        <div class="card border-l-4 border-l-bad p-4 sm:p-5" data-card="${r.kind}">
          ${head}
          <div class="mt-1.5">${pill("bg-bad-soft text-bad", "Не е намерена валидна")}</div>
          <a href="${cta.href}" class="btn-primary mt-3 w-full sm:w-auto">${cta.label}</a>
        </div>`;
    }

    if (r.status === "manual") {
      return `
        <div class="card border-l-4 border-l-line-strong p-4 sm:p-5" data-card="${r.kind}">
          ${head}
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">${esc(r.note)}</p>
          <div class="mt-3 flex flex-col gap-2 sm:flex-row">
            <button type="button" data-retry="${r.kind}" class="btn-primary">Опитай отново</button>
            <a href="${r.officialUrl}" target="_blank" rel="nofollow noopener" data-copy-plate="${esc(plate)}" class="btn-secondary">
              Официална проверка ↗
            </a>
          </div>
          <p class="mt-2 text-xs text-ink-faint" data-copy-hint>При отваряне номерът се копира автоматично — поставете го във формата.</p>
        </div>`;
    }

    return `
      <div class="card border-l-4 border-l-line-strong p-4 sm:p-5" data-card="${r.kind}">
        ${head}
        <p class="mt-1.5 text-sm text-ink-soft">${esc(r.status === "error" ? r.message : "Проверката е временно недостъпна.")}</p>
        <button type="button" data-retry="${r.kind}" class="btn-secondary mt-3 w-full sm:w-auto">Опитай отново</button>
      </div>`;
  }

  const skeleton = (kind: CheckKind) => `
    <div class="card animate-pulse p-4 sm:p-5" data-card="${kind}">
      <p class="text-sm font-medium text-ink-soft">${LABELS[kind]}</p>
      <div class="mt-3 h-5 w-32 rounded-full bg-canvas"></div>
      <div class="mt-2 h-4 w-48 rounded bg-canvas"></div>
    </div>`;

  /** CB1234AB → „CB 1234 AB“ за по-четим вход */
  const prettyPlate = (plate: string) =>
    plate.replace(/^([A-Z]{1,2})(\d{4})([A-Z]{1,2})$/, "$1 $2 $3");

  const LAST_PLATE_KEY = "last-plate";
  const urlPlate = normalizePlate(new URLSearchParams(location.search).get("plate") ?? "");
  let autoSubmitted = false;

  for (const root of document.querySelectorAll<HTMLElement>("[data-plate-check]")) {
    const form = root.querySelector("form")!;
    const input = form.querySelector<HTMLInputElement>("input[name=plate]")!;
    const errorEl = form.querySelector<HTMLElement>("[data-plate-error]")!;
    const resultsEl = root.querySelector<HTMLElement>("[data-results]")!;
    const timestampEl = root.querySelector<HTMLElement>("[data-timestamp]")!;
    const kinds = (root.dataset.checks ?? "").split(",") as CheckKind[];
    const rtaUrl = root.dataset.rta ?? "";
    let lastPlate = "";

    const setCard = (kind: CheckKind, html: string) => {
      const el = resultsEl.querySelector(`[data-card="${kind}"]`);
      if (el) el.outerHTML = html;
    };

    /** Стандартна проверка (винетка/ГО) за един вид — ползва се и при retry. */
    async function runStandard(kind: CheckKind, plate: string): Promise<string> {
      try {
        const res = await fetch(`/api/check/${kind}?plate=${encodeURIComponent(plate)}`);
        const body = (await res.json()) as CheckResult | { message?: string };
        if (!res.ok) throw new Error((body as { message?: string }).message);
        return renderResult(body as CheckResult, plate);
      } catch (err) {
        return renderResult(
          {
            kind,
            status: "error",
            message:
              err instanceof Error && err.message
                ? err.message
                : "Проверката е временно недостъпна. Опитайте отново след малко.",
            officialUrl: "",
            checkedAt: new Date().toISOString(),
          },
          plate,
        );
      }
    }

    /** Стартира ГТП relay в свеж контейнер на мястото на текущата ГТП карта. */
    function startInspection(plate: string) {
      const el = resultsEl.querySelector(`[data-card="inspection"]`);
      if (!el) return;
      const container = document.createElement("div");
      container.dataset.card = "inspection";
      el.replaceWith(container);
      mountGtp(container, plate, rtaUrl);
    }

    /** Повтаря само една проверка (от бутона „Опитай отново“). */
    async function retryKind(kind: CheckKind) {
      if (!isValidBgPlate(lastPlate)) return;
      if (kind === "inspection") {
        startInspection(lastPlate);
        return;
      }
      setCard(kind, skeleton(kind));
      setCard(kind, await runStandard(kind, lastPlate));
    }

    // Предпопълване: ?plate= от URL (споделен линк) или последният проверен номер
    const initialPlate = isValidBgPlate(urlPlate)
      ? urlPlate
      : normalizePlate(localStorage.getItem(LAST_PLATE_KEY) ?? "");
    if (isValidBgPlate(initialPlate)) {
      input.value = prettyPlate(initialPlate);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const plate = normalizePlate(input.value);

      if (!isValidBgPlate(plate)) {
        errorEl.textContent = "Невалиден номер — въведете го като на табелата, напр. СВ 1234 АВ.";
        errorEl.hidden = false;
        return;
      }
      errorEl.hidden = true;
      timestampEl.hidden = true;
      lastPlate = plate;
      resultsEl.innerHTML = kinds.map(skeleton).join("");

      // Запомняме номера и правим резултата споделяем/bookmark-ваем
      localStorage.setItem(LAST_PLATE_KEY, plate);
      const shareUrl = new URL(location.href);
      shareUrl.searchParams.set("plate", plate);
      history.replaceState(null, "", shareUrl);

      await Promise.all(
        kinds.map(async (kind) => {
          // ГТП минава през relay (captcha се решава от потребителя в самата карта),
          // а не през /api/check/inspection — затова бързите проверки не чакат кода.
          if (kind === "inspection") {
            startInspection(plate);
            return;
          }
          setCard(kind, await runStandard(kind, plate));
        }),
      );

      const now = new Date().toLocaleTimeString("bg-BG", { hour: "2-digit", minute: "2-digit" });
      timestampEl.textContent = `Проверено в ${now} ч. · данни от официалните системи`;
      timestampEl.hidden = false;
    });

    resultsEl.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // „Опитай отново“ → повтаря само тази проверка
      const retry = target.closest<HTMLElement>("[data-retry]");
      if (retry) {
        void retryKind(retry.dataset.retry as CheckKind);
        return;
      }

      // Към официална проверка → номерът отива в клипборда, потребителят само го поставя
      const link = target.closest<HTMLElement>("[data-copy-plate]");
      const value = link?.dataset.copyPlate;
      if (!value) return;
      navigator.clipboard?.writeText(value).then(() => {
        const hint = link!.parentElement?.parentElement?.querySelector("[data-copy-hint]");
        if (hint) hint.textContent = `Номер ${value} е копиран — поставете го във формата (Ctrl+V).`;
      });
    });

    // Отворен споделен линк (?plate=…) → проверката тръгва сама, без клик
    if (isValidBgPlate(urlPlate) && !autoSubmitted) {
      autoSubmitted = true;
      form.requestSubmit();
    }
  }
</script>
