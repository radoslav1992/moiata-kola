---
/**
 * ГТП проверка по регистрационен номер с relay към ИААА.
 * Captcha-та се показва на потребителя — той я решава (не я заобикаляме).
 * При проблем се връща към насочена официална проверка (deep-link fallback).
 */
import { OFFICIAL_SOURCES } from "@/lib/site";
const officialUrl = OFFICIAL_SOURCES.rta.checkUrl;
---

<section class="card p-5 sm:p-8" data-gtp-relay data-official={officialUrl}>
  <form class="flex flex-col items-center gap-4" novalidate>
    <label class="sr-only" for="gtp-plate">Регистрационен номер</label>
    <div class="flex h-16 w-full max-w-sm items-stretch overflow-hidden rounded-lg border-2 border-ink/80 bg-white focus-within:border-accent sm:h-20">
      <span class="flex w-10 shrink-0 flex-col items-center justify-center gap-1 bg-accent text-white sm:w-12" aria-hidden="true">
        <span class="font-plate text-xs font-semibold tracking-wide sm:text-sm">BG</span>
      </span>
      <input
        id="gtp-plate"
        name="plate"
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="10"
        placeholder="СВ 1234 АВ"
        class="font-plate w-full min-w-0 border-0 bg-transparent text-center text-3xl font-semibold tracking-[0.18em] text-ink uppercase outline-none placeholder:text-ink-faint/50 sm:text-4xl"
        required
      />
    </div>

    <!-- Стъпка с код: показва се след зареждане на картинката -->
    <div class="flex w-full max-w-sm flex-col items-center gap-3" data-captcha-step hidden>
      <div class="flex w-full items-center gap-3">
        <img alt="Код за сигурност от ИААА" class="h-14 rounded-md border border-line bg-white" data-captcha-img />
        <button type="button" class="text-sm font-medium text-accent hover:underline" data-captcha-refresh>
          Нов код
        </button>
      </div>
      <label class="sr-only" for="gtp-captcha">Код от картинката</label>
      <input
        id="gtp-captcha"
        name="captcha"
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="8"
        placeholder="Код от картинката"
        class="w-full rounded-lg border border-line-strong bg-white px-4 py-3 text-center text-lg tracking-widest text-ink uppercase outline-none focus:border-accent"
      />
    </div>

    <button type="submit" class="btn-primary w-full max-w-sm text-base" data-submit>
      Провери ГТП
    </button>
    <p class="text-xs text-ink-faint" data-error hidden></p>
  </form>

  <div class="mt-6 space-y-3 empty:mt-0" data-result aria-live="polite"></div>
  <p class="mt-4 text-center text-xs text-ink-faint" data-timestamp hidden></p>
</section>

<script>
  import { normalizePlate, isValidBgPlate } from "@/lib/checks/types";

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric" });

  for (const root of document.querySelectorAll<HTMLElement>("[data-gtp-relay]")) {
    const form = root.querySelector("form")!;
    const plateInput = form.querySelector<HTMLInputElement>("input[name=plate]")!;
    const captchaStep = form.querySelector<HTMLElement>("[data-captcha-step]")!;
    const captchaImg = form.querySelector<HTMLImageElement>("[data-captcha-img]")!;
    const captchaInput = form.querySelector<HTMLInputElement>("input[name=captcha]")!;
    const refreshBtn = form.querySelector<HTMLButtonElement>("[data-captcha-refresh]")!;
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const errorEl = form.querySelector<HTMLElement>("[data-error]")!;
    const resultEl = root.querySelector<HTMLElement>("[data-result]")!;
    const timestampEl = root.querySelector<HTMLElement>("[data-timestamp]")!;
    const officialUrl = root.dataset.official!;

    let session: string | null = null;

    const LAST_PLATE_KEY = "last-plate";
    const stored = normalizePlate(localStorage.getItem(LAST_PLATE_KEY) ?? "");
    if (isValidBgPlate(stored)) plateInput.value = stored.replace(/^([A-Z]{1,2})(\d{4})([A-Z]{1,2})$/, "$1 $2 $3");

    const fallbackCard = (note: string) => `
      <div class="card border-l-4 border-l-line-strong p-4 sm:p-5">
        <p class="text-sm font-medium text-ink-soft">ГТП (технически преглед)</p>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">${esc(note)}</p>
        <a href="${officialUrl}" target="_blank" rel="nofollow noopener" class="btn-secondary mt-3 w-full sm:w-auto">Официална проверка ↗</a>
      </div>`;

    async function loadCaptcha() {
      captchaStep.hidden = true;
      try {
        const res = await fetch("/api/gtp/captcha");
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { session: string; image: string };
        session = data.session;
        captchaImg.src = data.image;
        captchaInput.value = "";
        captchaStep.hidden = false;
        captchaInput.focus();
      } catch {
        resultEl.innerHTML = fallbackCard(
          "Връзката със системата на ИААА е временно недостъпна. Проверете директно в официалната система — отнема под минута.",
        );
      }
    }

    refreshBtn.addEventListener("click", loadCaptcha);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const plate = normalizePlate(plateInput.value);
      if (!isValidBgPlate(plate)) {
        errorEl.textContent = "Невалиден номер — въведете го като на табелата, напр. СВ 1234 АВ.";
        errorEl.hidden = false;
        return;
      }
      errorEl.hidden = true;
      localStorage.setItem(LAST_PLATE_KEY, plate);

      // Първи submit без код → зареждаме captcha и спираме
      if (captchaStep.hidden || !session) {
        await loadCaptcha();
        return;
      }
      const captcha = captchaInput.value.trim();
      if (!captcha) {
        errorEl.textContent = "Впишете кода от картинката.";
        errorEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Проверявам…";
      try {
        const res = await fetch("/api/gtp/check", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ session, plate, captcha }),
        });
        const r = (await res.json()) as
          | { status: "ok"; valid: boolean; validTo?: string }
          | { status: "captcha_error" }
          | { status: "not_found" }
          | { status: "error"; message?: string };

        if (r.status === "captcha_error") {
          errorEl.textContent = "Грешен код — опитайте с новия код.";
          errorEl.hidden = false;
          await loadCaptcha();
        } else if (r.status === "ok" && r.validTo) {
          const days = Math.ceil((new Date(r.validTo).getTime() - Date.now()) / 86_400_000);
          const expiring = days <= 30;
          resultEl.innerHTML = `
            <div class="card flex items-center justify-between gap-4 border-l-4 ${r.valid ? (expiring ? "border-l-warn" : "border-l-ok") : "border-l-bad"} p-4 sm:p-5">
              <div>
                <p class="text-sm font-medium text-ink-soft">ГТП (технически преглед)</p>
                <div class="mt-1.5">
                  <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${r.valid ? (expiring ? "bg-warn-soft text-warn" : "bg-ok-soft text-ok") : "bg-bad-soft text-bad"}">
                    ${r.valid ? (expiring ? "Изтича скоро" : "Валиден") : "Изтекъл"}
                  </span>
                </div>
                <p class="mt-2 text-sm text-ink-soft">Валиден до <strong class="text-ink">${fmtDate(r.validTo)}</strong></p>
                ${expiring ? `<a href="/gtp/cena" class="mt-2 inline-block text-sm font-semibold text-accent hover:underline">Виж цените за ГТП →</a>` : ""}
              </div>
              <div class="shrink-0 text-center">
                <p class="font-plate text-4xl font-semibold ${r.valid ? (expiring ? "text-warn" : "text-ok") : "text-bad"} sm:text-5xl">${Math.max(0, days)}</p>
                <p class="text-xs text-ink-faint">${Math.abs(days) === 1 ? "ден" : "дни"}</p>
              </div>
            </div>`;
          captchaStep.hidden = true;
          session = null;
          const now = new Date().toLocaleTimeString("bg-BG", { hour: "2-digit", minute: "2-digit" });
          timestampEl.textContent = `Проверено в ${now} ч. · данни от ИААА`;
          timestampEl.hidden = false;
        } else if (r.status === "not_found") {
          resultEl.innerHTML = fallbackCard(
            "За този номер не е намерен валиден технически преглед. Проверете номера или вижте директно в официалната система.",
          );
          captchaStep.hidden = true;
        } else {
          resultEl.innerHTML = fallbackCard(
            "Проверката през ИААА е временно недостъпна. Проверете директно в официалната система.",
          );
        }
      } catch {
        resultEl.innerHTML = fallbackCard("Проверката е временно недостъпна. Опитайте отново след малко.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = captchaStep.hidden ? "Провери ГТП" : "Провери ГТП с кода";
      }
    });
  }
</script>
