---
/**
 * Банер за съгласие с бисквитки (аналитични + рекламни). Монтира се от
 * Base.astro на всяка страница — Google Analytics се зарежда само при
 * съгласие, затова банерът не зависи от ADS_ENABLED.
 *
 * Изборът се пази в localStorage под ключ "cookie-consent" ("granted"/"denied").
 * Скриптове, които ползват бисквитки (GA, бъдещ AdSense), се изпълняват само
 * при "granted":
 *   if (localStorage.getItem("cookie-consent") === "granted") { ...зареди... }
 * и слушат събитието "cookie-consent-change" за късно дадено съгласие.
 */
---

<div
  data-consent-banner
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-card p-4 sm:p-5"
  role="region"
  aria-label="Съгласие за бисквитки"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-ink-soft">
      Ползваме бисквитки за анонимна статистика (Google Analytics), а статиите може да показват реклама.
      Проверките работят без бисквитки — независимо от избора ви.
      <a href="/poveritelnost" class="font-medium text-accent underline decoration-accent/30 underline-offset-2">Повече за данните</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button type="button" data-consent="denied" class="btn-secondary px-4 py-2 text-sm">Отказвам</button>
      <button type="button" data-consent="granted" class="btn-primary px-4 py-2 text-sm">Приемам</button>
    </div>
  </div>
</div>

<script>
  const KEY = "cookie-consent";
  const banner = document.querySelector<HTMLElement>("[data-consent-banner]");

  if (banner && !localStorage.getItem(KEY)) {
    banner.hidden = false;
    banner.addEventListener("click", (e) => {
      const choice = (e.target as HTMLElement).closest<HTMLElement>("[data-consent]")?.dataset.consent;
      if (!choice) return;
      localStorage.setItem(KEY, choice);
      banner.hidden = true;
      window.dispatchEvent(new CustomEvent("cookie-consent-change", { detail: choice }));
    });
  }
</script>
