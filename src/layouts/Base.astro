---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ConsentBanner from "@/components/ConsentBanner.astro";
import { SITE } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  /** JSON-LD обекти, които страницата добавя към <head> */
  schema?: Record<string, unknown>[];
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Път до OG картата на страницата, ако не е общата (напр. "/og-statistika.png") */
  ogImagePath?: string;
}

const {
  title,
  description,
  schema = [],
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  ogImagePath = "/og-default.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, "") || Astro.site?.href;
const ogImage = new URL(ogImagePath, Astro.site).href;

const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    logo: new URL("/favicon.svg", SITE.url).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    inLanguage: "bg",
    description: SITE.description,
    publisher: { "@id": `${SITE.url}/#organization` },
  },
  ...schema,
];
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f9fb" />

    <!-- Google tag (gtag.js) — зарежда се само при съгласие от банера за бисквитки -->
    <script is:inline>
      (function () {
        function loadGA() {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", "G-D9YJY1M1RR");
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-D9YJY1M1RR";
          document.head.appendChild(s);
        }
        if (localStorage.getItem("cookie-consent") === "granted") loadGA();
        else window.addEventListener("cookie-consent-change", function (e) {
          if (e.detail === "granted") loadGA();
        });
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.tagline} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
