---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PlateCheck from "@/components/PlateCheck.astro";
import Faq from "@/components/Faq.astro";
import { SITE, OFFICIAL_SOURCES, toolTitle } from "@/lib/site";

const title = toolTitle("Проверка на винетка");
const description =
  "Проверка на винетка онлайн по регистрационен номер: валидна ли е, какъв вид е и до коя дата важи. Безплатна справка с данни от БГ ТОЛ — без регистрация.";

const faqItems = [
  {
    q: "Как да си проверя винетката?",
    a: "Въведете регистрационния номер в полето по-горе и натиснете „Провери“. Системата прави справка в БГ ТОЛ онлайн и показва дали има активна електронна винетка, от кой вид е и докога важи.",
  },
  {
    q: "Каква е разликата между тази проверка и check.bgtoll.bg?",
    a: "Данните са същите — от официалната система на Национално тол управление. Разликата е в удобството: тук с едно въвеждане можете да проверите и Гражданска отговорност, и ГТП, а резултатът е оптимизиран за телефон.",
  },
  {
    q: "Купих винетка, но проверката не я показва. Защо?",
    a: "Най-честите причини са сгрешен номер при покупката или забавяне при активирането. Вижте подробното ръководство „<a href='/statii/kupih-vinetka-no-ne-se-pokazva'>Купих винетка, но проверката не я показва</a>“ — там са всички стъпки за реакция.",
  },
  {
    q: "Какво значи „валидност на винетка“ и откога тече?",
    a: "Електронната винетка важи от началната дата, която сте избрали при покупката, до изтичането на периода ѝ (уикенд, седмица, месец, тримесечие или година). Точната крайна дата виждате в резултата от проверката.",
  },
  {
    q: "Имам ли нужда от винетка за моя маршрут?",
    a: "Винетка е нужна за републиканските пътища — автомагистрали и пътища I, II и III клас. Общинските улици и пътища в населени места не изискват винетка.",
  },
  {
    q: "Как да проверя до кога ми е винетката?",
    a: "По същия начин — въведете регистрационния номер по-горе. Резултатът показва точната крайна дата и колко дни остават. Подробно за сроковете на всеки вид: „<a href='/statii/validnost-na-vinetka'>Валидност на винетка — до кога важи</a>“.",
  },
  {
    q: "Как да проверя дали имам винетка?",
    a: "На въпроса „имам ли винетка“ проверката по номер отговаря веднага: ако за автомобила няма активна електронна винетка, резултатът го показва ясно. Полезно при служебни и семейни коли, където винетката често я купува друг.",
  },
  {
    q: "Винетката през АПИ ли се проверява?",
    a: "Вече не — преди години проверката минаваше през Агенция „Пътна инфраструктура“ (АПИ), но от 2019 г. електронните винетки са в системата на БГ ТОЛ (Национално тол управление). Справката тук чете именно нея.",
  },
  {
    q: "Как се проверява винетен стикер?",
    a: "Винетни стикери няма от 1 януари 2019 г. — проверява се електронната винетка по регистрационен номер. Защо стикерът на стъклото не значи нищо: „<a href='/statii/vineten-stiker'>Винетен стикер — вече не съществува</a>“.",
  },
  {
    q: "Мога ли да проверя дали имам глоба за винетка?",
    a: "Глобите и електронните фишове са в системата на МВР, не на БГ ТОЛ. Използвайте <a href='/globi/proverka'>проверката на глоби</a> — а колко струва карането без винетка, вижте в „<a href='/statii/globa-za-lipsvashta-vinetka'>Глоба за липсваща винетка</a>“.",
  },
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Проверка на винетка по регистрационен номер",
  url: `${SITE.url}/vinetka/proverka`,
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  inLanguage: "bg",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  description,
};
---

<Base {title} {description} schema={[appSchema]}>
  <Breadcrumbs crumbs={[{ href: "/vinetka/proverka", label: "Проверка на винетка" }]} />

  <section class="mx-auto max-w-5xl px-4 pt-6 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl sm:text-4xl">Проверка на винетка</h1>
      <p class="mt-3 text-ink-soft sm:text-lg">
        Въведете номера от табелата — виждате валидност, вид и краен срок на електронната винетка за
        секунди.
      </p>
    </div>
    <div class="mx-auto mt-7 max-w-2xl">
      <PlateCheck checks={["vignette"]} buttonLabel="Провери винетката" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose-app">
      <h2>Какво показва проверката</h2>
      <p>
        Справката се прави в реално време в системата на
        <a href={OFFICIAL_SOURCES.bgtoll.checkUrl} rel="nofollow noopener">БГ ТОЛ</a> — същата, която ползват
        камерите по пътищата. Резултатът включва:
      </p>
      <ul>
        <li><strong>Има ли активна електронна винетка</strong> за този номер;</li>
        <li><strong>Вида ѝ</strong> — уикенд, седмична, месечна, тримесечна или годишна;</li>
        <li><strong>Крайния срок</strong> и колко дни остават до изтичането.</li>
      </ul>
      <p>
        Ако винетката изтича до 7 дни, ще видите предупреждение — така подновявате навреме и избягвате
        <a href="/statii/globa-za-lipsvashta-vinetka">компенсаторната такса и глобата</a>. И както и да го
        наричате — проверка, справка или „преглед на винетка“ — източникът е един и резултатът е същият.
      </p>

      <h2>Кога е добре да проверите</h2>
      <ul>
        <li>Преди пътуване по магистрала или извънградски път;</li>
        <li>Веднага след покупка на винетка — за да сте сигурни, че номерът е въведен вярно;</li>
        <li>При <a href="/statii/kupuvam-kola-vtora-ruka-checklist">покупка на кола втора ръка</a>;</li>
        <li>Когато карате чужд автомобил — служебен, на роднина, нает.</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-4 sm:px-6">
    <Faq items={faqItems} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="card flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="text-xl">Нямате валидна винетка?</h2>
        <p class="mt-1 text-sm text-ink-soft">Купете електронна винетка онлайн за 2 минути — важи веднага.</p>
      </div>
      <a href="/vinetka/kupi" class="btn-primary shrink-0">Купи винетка онлайн</a>
    </div>
  </section>
</Base>
