---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PlateCheck from "@/components/PlateCheck.astro";
import Faq from "@/components/Faq.astro";

const title = "Проверка на винетка за инвалиди — социално подпомагане (АСП) | По номер";
const description =
  "Проверка на безплатната винетка за хора с увреждания по регистрационен номер — издадена чрез Агенцията за социално подпомагане (АСП). Кой има право, как се кандидатства и какво да правите, ако проверката не я показва.";

const faqItems = [
  {
    q: "Как се проверява винетка от социалното подпомагане?",
    a: "По същия начин като всяка електронна винетка — въведете регистрационния номер в полето по-горе. Безплатните винетки, издадени чрез Агенцията за социално подпомагане (АСП), се виждат в системата на БГ ТОЛ като годишни е-винетки.",
  },
  {
    q: "Има ли отделна проверка в БГ ТОЛ за винетка за инвалиди?",
    a: "Не — системата на БГ ТОЛ е една и проверката е една, по регистрационен номер. Безплатната винетка от АСП изглежда в справката като обикновена годишна е-винетка.",
  },
  {
    q: "Кой има право на безплатна винетка за инвалиди?",
    a: "Хора с 50% и над 50% намалена работоспособност, както и семейства, отглеждащи дете с трайно увреждане. Правото важи за един лек автомобил — собствен или съпружеска собственост, с обем на двигателя до 2000 куб. см и мощност до 160 к.с.",
  },
  {
    q: "Как се кандидатства за безплатната винетка?",
    a: "Със заявление-декларация в дирекция „Социално подпомагане“ по настоящ адрес — лично, чрез пълномощник или електронно. Прилагате решението на ТЕЛК/НЕЛК и талона на автомобила. АСП подава данните към БГ ТОЛ и винетката се активира електронно.",
  },
  {
    q: "Подадох заявление, но проверката не показва винетка. Какво да правя?",
    a: "Активирането обикновено отнема до 14 дни от одобрението. Ако срокът е минал, позвънете в дирекция „Социално подпомагане“, където сте подали заявлението, и проверете статуса. Не тръгвайте по републикански път преди винетката да се вижда в проверката — камерите не правят изключения.",
  },
  {
    q: "Подновява ли се безплатната винетка автоматично?",
    a: "Не — всяка година се подава ново заявление. Сложете си напомняне около месец преди изтичането; точната дата виждате в проверката по-горе.",
  },
  {
    q: "Какво става при смяна на автомобила?",
    a: "Подава се ново заявление с данните на новия автомобил — винетката е обвързана с регистрационния номер и не се прехвърля автоматично.",
  },
];
---

<Base {title} {description}>
  <Breadcrumbs
    crumbs={[
      { href: "/vinetka/proverka", label: "Проверка на винетка" },
      { href: "/vinetka/za-invalidi", label: "Винетка за инвалиди" },
    ]}
  />

  <section class="mx-auto max-w-5xl px-4 pt-6 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl sm:text-4xl">Проверка на винетка за инвалиди</h1>
      <p class="mt-3 text-ink-soft sm:text-lg">
        Безплатната е-винетка от социалното подпомагане (АСП) се проверява като всяка друга — по номера на
        автомобила.
      </p>
    </div>
    <div class="mx-auto mt-7 max-w-2xl">
      <PlateCheck checks={["vignette"]} buttonLabel="Провери винетката" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose-app">
      <h2>Кой има право на безплатна винетка</h2>
      <p>
        Държавата осигурява <strong>безплатна годишна електронна винетка</strong> за хора с
        <strong>50% и над 50% намалена работоспособност</strong> (решение на ТЕЛК/НЕЛК) и за семейства,
        отглеждащи <strong>дете с трайно увреждане</strong>. Условията за автомобила: лек автомобил до
        2000 куб. см и до 160 к.с., собственост или съпружеска имуществена общност.
      </p>

      <h2>Стъпките през Агенцията за социално подпомагане (АСП)</h2>
      <ol>
        <li>Заявление-декларация в дирекция „Социално подпомагане“ по настоящ адрес (или електронно);</li>
        <li>Прилагате копие от решението на ТЕЛК/НЕЛК и свидетелството за регистрация на МПС;</li>
        <li>АСП проверява условията и подава данните към БГ ТОЛ;</li>
        <li>Винетката се активира електронно — проверявате я по номер в полето по-горе.</li>
      </ol>

      <h2>Най-важното, което хората пропускат</h2>
      <ul>
        <li><strong>Винетката не се подновява сама</strong> — ново заявление всяка година;</li>
        <li><strong>Активирането отнема дни</strong> — проверете преди първото пътуване;</li>
        <li><strong>Камерите не знаят, че чакате одобрение</strong> — без активна винетка следва компенсаторна такса, която после се обжалва трудно.</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-10 sm:px-6">
    <Faq items={faqItems} />
  </section>
</Base>
