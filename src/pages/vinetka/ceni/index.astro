---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PriceTable from "@/components/PriceTable.astro";
import VignetteCalculator from "@/components/VignetteCalculator.astro";
import Faq from "@/components/Faq.astro";
import { PRICES_UPDATED_HUMAN, PRICES_EFFECTIVE_HUMAN, priceBySlug, fmtEur, fmtBgn } from "@/data/vignette-prices";

const dnevna = priceBySlug("dnevna");
const uikend = priceBySlug("uikend");
const sedmichna = priceBySlug("sedmichna");
const mesechna = priceBySlug("mesechna");
const godishna = priceBySlug("godishna");

const title = "Цени на винетки 2026 — нови цени от 1 август, в евро и лева | По номер";
const description = `Новите цени на винетките от ${PRICES_EFFECTIVE_HUMAN}: годишна ${fmtEur(godishna.priceEur)} (${fmtBgn(godishna.priceBgn)}), месечна ${fmtEur(mesechna.priceEur)}, седмична ${fmtEur(sedmichna.priceEur)}, уикенд ${fmtEur(uikend.priceEur)}, еднодневна ${fmtEur(dnevna.priceEur)}. Калкулатор кой вид е най-изгоден.`;

const faqItems = [
  {
    q: "Колко струва годишната винетка за лек автомобил?",
    a: `Годишната винетка струва ${fmtEur(godishna.priceEur)} (${fmtBgn(godishna.priceBgn)}) и важи 12 месеца от избраната от вас начална дата — не от 1 януари.`,
  },
  {
    q: "Поскъпнаха ли винетките през 2026 г.?",
    a: `Да — от ${PRICES_EFFECTIVE_HUMAN} цените за леки автомобили са с около 30% по-високи: годишната стана ${fmtEur(godishna.priceEur)} (беше 49,60 €), месечната — ${fmtEur(mesechna.priceEur)} (беше 15,34 €), седмичната — ${fmtEur(sedmichna.priceEur)} (беше 7,67 €), уикенд — ${fmtEur(uikend.priceEur)} (беше 5,11 €), а еднодневната — ${fmtEur(dnevna.priceEur)} (беше 4,09 €).`,
  },
  {
    q: "Има ли еднодневна винетка за леки автомобили?",
    a: `Да — от 3 февруари 2026 г. Струва ${fmtEur(dnevna.priceEur)} и важи 24 часа от избрания начален час. Подробности на страницата за <a href='/vinetka/ceni/dnevna'>еднодневната винетка</a>.`,
  },
  {
    q: "Откога важи винетката след покупка онлайн?",
    a: "Електронната винетка важи от началната дата и час, които изберете при покупката — може и веднага. Няма стикер: камерите я виждат по регистрационния номер.",
  },
  {
    q: "Кои пътища изискват винетка?",
    a: "Автомагистралите и републиканските пътища I, II и III клас. Уличната мрежа в населените места и общинските пътища не изискват винетка.",
  },
];
---

<Base {title} {description}>
  <Breadcrumbs crumbs={[{ href: "/vinetka/ceni", label: "Цени на винетки" }]} />

  <section class="mx-auto max-w-3xl px-4 pt-6 text-center sm:px-6">
    <h1 class="text-3xl sm:text-4xl">Цени на винетките за 2026 г.</h1>
    <p class="mx-auto mt-3 max-w-2xl text-ink-soft sm:text-lg">
      Официалните цени за леки автомобили до 3,5 т — в евро и лева, по тарифата в сила от
      {PRICES_EFFECTIVE_HUMAN}. Последна проверка: {PRICES_UPDATED_HUMAN}
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-8 sm:px-6">
    <PriceTable />
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-10 sm:px-6">
    <VignetteCalculator />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose-app">
      <h2>Кой вид винетка да изберете</h2>
      <p>
        Правилото е просто: сметнете колко уикенд пътувания правите за година. До 9 пътувания —
        по-евтино е да купувате <a href="/vinetka/ceni/uikend">уикенд винетки</a> на парче. Над 9 —
        <a href="/vinetka/ceni/godishna">годишната</a> вече се изплаща. За отпуск до седмица е
        <a href="/vinetka/ceni/sedmichna">седмичната</a>, за един ден път —
        <a href="/vinetka/ceni/dnevna">еднодневната</a>, за сезонна работа —
        <a href="/vinetka/ceni/mesechna">месечната или тримесечната</a>.
      </p>
      <p>
        Преди да купите нова, <a href="/vinetka/proverka">проверете дали нямате активна винетка</a> — при
        годишните хората често забравят точната дата на изтичане.
      </p>
      <p>
        Цените важат за всички МПС до 3,5 т — кола, бус или пикап. Какво важи за ремаркета, камиони и
        транзитни номера: <a href="/statii/vidove-vinetki-kategorii">Видове винетки и категории МПС</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-6 sm:px-6">
    <Faq items={faqItems} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <div class="card flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="text-xl">Избрахте вид?</h2>
        <p class="mt-1 text-sm text-ink-soft">Купете електронната винетка онлайн — важи от минутата, която изберете.</p>
      </div>
      <a href="/vinetka/kupi" class="btn-primary shrink-0">Купи винетка онлайн</a>
    </div>
  </section>
</Base>
