---
import VignettePricePage from "@/layouts/VignettePricePage.astro";
import { priceBySlug, fmtEur, fmtBgn, COMPENSATORY_FEE_EUR } from "@/data/vignette-prices";

const sedmichna = priceBySlug("sedmichna");
const uikend = priceBySlug("uikend");
const dnevna = priceBySlug("dnevna");

const faqItems = [
  {
    q: "Колко струва седмичната винетка?",
    a: `${fmtEur(sedmichna.priceEur)} (${fmtBgn(sedmichna.priceBgn)}) за лек автомобил. Важи 7 календарни дни от началната дата, която изберете.`,
  },
  {
    q: "Седмична или уикенд винетка — коя да взема?",
    a: `Ако пътувате само между петък на обяд и неделя вечер — уикенд (${fmtEur(uikend.priceEur)}). Тръгвате ли по-рано, връщате ли се в понеделник, или оставате повече дни — седмична (${fmtEur(sedmichna.priceEur)}).`,
  },
  {
    q: "Седмична или две еднодневни?",
    a: `Две <a href='/vinetka/ceni/dnevna'>еднодневни винетки</a> излизат ${fmtEur(dnevna.priceEur * 2)} — повече от седмичната. Еднодневната си струва само ако наистина пътувате в рамките на 24 часа.`,
  },
  {
    q: "Откога започва да тече седмицата?",
    a: "От 00:00 ч. на началната дата, която посочите при покупката, до 23:59 ч. на седмия ден. Може да я купите предварително с бъдеща начална дата.",
  },
  {
    q: "Подходяща ли е за гости от чужбина?",
    a: "Да — това е стандартният избор на българи, прибиращи се за седмица, и на транзитно преминаващи. Купува се онлайн преди пътуването, без стикер и без чакане на граница.",
  },
];
---

<VignettePricePage
  priceSlug="sedmichna"
  urlSlug="sedmichna"
  title={`Седмична винетка — цена ${fmtEur(sedmichna.priceEur)} (${fmtBgn(sedmichna.priceBgn)}) | По номер`}
  description={`Седмична винетка за лек автомобил: цена ${fmtEur(sedmichna.priceEur)} (${fmtBgn(sedmichna.priceBgn)}) по тарифата от 1 август 2026 г., валидност 7 календарни дни от избрана дата. Кога е по-изгодна от уикенд и еднодневна винетка.`}
  h1="Седмична винетка — цена и валидност"
  {faqItems}
>
  <p>
    <strong>Седмичната винетка струва {fmtEur(sedmichna.priceEur)} ({fmtBgn(sedmichna.priceBgn)})</strong> и
    важи 7 календарни дни от избраната от вас начална дата. Това е правилният избор за отпуска,
    командировка или гостуване, което не се побира в уикенда.
  </p>
  <h2>Седмична срещу уикенд</h2>
  <p>
    Разликата е {fmtEur(sedmichna.priceEur - uikend.priceEur)} — но уикенд винетката важи едва от петък
    12:00 ч. Ако има и минимален шанс да тръгнете по-рано или да се върнете след неделя, седмичната ви
    спестява <a href="/statii/globa-za-lipsvashta-vinetka">компенсаторната такса от {fmtEur(COMPENSATORY_FEE_EUR)}</a>.
    Евтината застраховка на спокойствието.
  </p>
</VignettePricePage>
