---
import VignettePricePage from "@/layouts/VignettePricePage.astro";

const faqItems = [
  {
    q: "Колко струва годишната винетка за лек автомобил?",
    a: "49,60 € (97 лв.) — цената е еднаква навсякъде: на сайта на БГ ТОЛ, в приложения, на бензиностанции и на каса.",
  },
  {
    q: "Откога до кога важи годишната винетка?",
    a: "Точно 12 месеца от началната дата, която изберете при покупката. Купена на 15 март, важи до 14 март следващата година включително — не е обвързана с календарната година.",
  },
  {
    q: "Прехвърля ли се годишната винетка при продажба на колата?",
    a: "Да — винетката е обвързана с регистрационния номер, а не със собственика. Ако номерът се запази, винетката остава валидна. Подробности в статията „<a href='/statii/prehvarlya-li-se-vinetkata'>Прехвърля ли се винетката при продажба</a>“.",
  },
  {
    q: "Кога се изплаща годишната спрямо уикенд винетките?",
    a: "При 10 или повече уикенд пътувания годишно (10 × 5,11 € = 51,10 € > 49,60 €). Ако карате по магистрала поне веднъж месечно, годишната е по-изгодна.",
  },
  {
    q: "Как да проверя кога ми изтича годишната винетка?",
    a: "С безплатната <a href='/vinetka/proverka'>проверка на винетка по номер</a> — показва точната крайна дата и колко дни остават.",
  },
];
---

<VignettePricePage
  priceSlug="godishna"
  urlSlug="godishna"
  title="Годишна винетка — цена 49,60 € (97 лв.) и валидност | Моята кола"
  description="Годишна винетка за лек автомобил: цена 49,60 € (97 лв.), валидност 12 месеца от избрана дата. Кога се изплаща спрямо уикенд и месечна винетка и как се проверява срокът."
  h1="Годишна винетка — цена и валидност"
  {faqItems}
>
  <p>
    <strong>Годишната винетка струва 49,60 € (97 лв.)</strong> и важи 12 месеца от датата, която изберете
    при покупката. Това е най-купуваният вид — и с основание: ако излизате на републикански път поне
    веднъж месечно, тя е най-евтиният вариант на километър.
  </p>
  <h2>Кога годишната е правилният избор</h2>
  <ul>
    <li>Пътувате по магистрала или извънградски пътища <strong>10+ пъти годишно</strong>;</li>
    <li>Живеете в населено място, свързано с работата ви през републикански път;</li>
    <li>Не искате да мислите за винетка цяла година — купувате и забравяте.</li>
  </ul>
  <p>
    Внимавайте само с датата на изтичане: системата не ви уведомява сама. Проверявайте срока с
    <a href="/vinetka/proverka">проверката по номер</a> преди по-дълги пътувания.
  </p>
</VignettePricePage>
