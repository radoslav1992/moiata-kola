---
import VignettePricePage from "@/layouts/VignettePricePage.astro";
import { priceBySlug, fmtEur, fmtBgn } from "@/data/vignette-prices";

const trimesechna = priceBySlug("trimesechna");

const faqItems = [
  {
    q: "Колко струва месечната винетка?",
    a: "15,34 € (30 лв.) за лек автомобил. Важи един месец от началната дата, която изберете.",
  },
  {
    q: "Колко струва тримесечната винетка?",
    a: "27,61 € (54 лв.) — около 40% по-евтино от три отделни месечни (46,02 €). Ако ви трябват повече от 6 седмици покритие, тримесечната почти винаги е по-изгодна.",
  },
  {
    q: "Месечна или годишна — къде е границата?",
    a: "Три месечни (46,02 €) вече са близо до цената на годишната (49,60 €). Трябва ли ви покритие за повече от 3 месеца в годината — взимайте направо годишна.",
  },
  {
    q: "Месец означава ли 30 дни?",
    a: "Календарен месец: купена на 10 юни, важи до 9 юли включително — независимо колко дни има месецът.",
  },
];
---

<VignettePricePage
  priceSlug="mesechna"
  urlSlug="mesechna"
  title="Месечна винетка — цена 15,34 €, тримесечна — 27,61 € | Моята кола"
  description="Месечна винетка за лек автомобил: 15,34 € (30 лв.). Тримесечна: 27,61 € (54 лв.) — кога тримесечната е по-изгодна и къде е границата с годишната."
  h1="Месечна и тримесечна винетка — цени"
  {faqItems}
>
  <p>
    <strong>Месечната винетка струва 15,34 € (30 лв.)</strong>, а тримесечната —
    <strong>{fmtEur(trimesechna.priceEur)} ({fmtBgn(trimesechna.priceBgn)})</strong>. Двете покриват
    една и съща нужда — по-дълъг период на редовно каране — затова ги разглеждаме заедно.
  </p>
  <h2>Сметката, която повечето хора пропускат</h2>
  <ul>
    <li>3 × месечна = 46,02 € — срещу 27,61 € за тримесечна. <strong>Тримесечната печели с 40%</strong>;</li>
    <li>2 × тримесечна = 55,22 € — срещу 49,60 € за годишна. <strong>Годишната вече е по-евтина</strong>.</li>
  </ul>
  <p>
    Правило: до 6 седмици нужда — месечна (или две). Един сезон — тримесечна. Повече — направо
    <a href="/vinetka/ceni/godishna">годишна</a>.
  </p>
</VignettePricePage>
