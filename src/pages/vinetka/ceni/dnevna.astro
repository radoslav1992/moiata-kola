---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PriceTable from "@/components/PriceTable.astro";
import Faq from "@/components/Faq.astro";

const title = "Еднодневна винетка — има ли такава и какво да купите вместо нея | Моята кола";
const description =
  "Еднодневна винетка за леки автомобили не съществува — дневната винетка е само за камиони и автобуси. Най-евтините алтернативи за един ден път: уикенд винетка 5,11 € или седмична 7,67 €.";

const faqItems = [
  {
    q: "Има ли винетка за един ден за лек автомобил?",
    a: "Не. За леки автомобили до 3,5 т най-краткият вид е уикенд винетката (5,11 €). Дневна винетка съществува само за тежкотоварни автомобили и автобуси, които ползват и тол такси.",
  },
  {
    q: "Какво да купя за еднократно пътуване в делничен ден?",
    a: "Седмична винетка за 7,67 € (15 лв.) — тя е най-евтиният вариант, който покрива делнични дни. Уикенд винетката (5,11 €) върши работа само между петък 12:00 ч. и неделя 23:59 ч.",
  },
  {
    q: "Защо няма дневна винетка за леки коли?",
    a: "Така е устроена тарифната политика на БГ ТОЛ: леките автомобили плащат само винетка (време), а тежките — тол такса на изминато разстояние, при която дневната винетка е преходен вариант.",
  },
  {
    q: "Пътувам само 20 км по магистрала — пак ли ми трябва винетка?",
    a: "Да — винетката се дължи за всяко движение по републикански път, независимо от разстоянието. Камерите засичат номера още при първото включване на магистралата.",
  },
];
---

<Base {title} {description}>
  <Breadcrumbs
    crumbs={[
      { href: "/vinetka/ceni", label: "Цени на винетки" },
      { href: "/vinetka/ceni/dnevna", label: "Еднодневна винетка" },
    ]}
  />

  <section class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <h1 class="text-center text-3xl sm:text-4xl">Еднодневна винетка — какво всъщност да купите</h1>

    <div class="prose-app mt-8">
      <p>
        <strong>Кратък отговор: еднодневна винетка за леки автомобили не съществува.</strong> Дневната
        винетка е само за камиони над 3,5 т и автобуси. За лека кола най-евтините варианти за кратко
        пътуване са два:
      </p>
      <ul>
        <li>
          <strong><a href="/vinetka/ceni/uikend">Уикенд винетка — 5,11 € (10 лв.)</a></strong> — ако
          пътувате между петък 12:00 ч. и неделя 23:59 ч.;
        </li>
        <li>
          <strong><a href="/vinetka/ceni/sedmichna">Седмична винетка — 7,67 € (15 лв.)</a></strong> — за
          всеки друг ден от седмицата.
        </li>
      </ul>
      <h2>Сравнете всички видове</h2>
    </div>

    <div class="mt-4">
      <PriceTable compact />
    </div>

    <div class="prose-app mt-8">
      <p>
        Преди да купите, <a href="/vinetka/proverka">проверете дали колата няма активна винетка</a> —
        особено ако е семеен или служебен автомобил.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <Faq items={faqItems} />
  </section>
</Base>
