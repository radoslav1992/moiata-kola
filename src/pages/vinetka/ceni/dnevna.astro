---
import VignettePricePage from "@/layouts/VignettePricePage.astro";
import { priceBySlug, fmtEur, fmtBgn } from "@/data/vignette-prices";

const dnevna = priceBySlug("dnevna");
const uikend = priceBySlug("uikend");
const sedmichna = priceBySlug("sedmichna");

const faqItems = [
  {
    q: "Има ли еднодневна винетка за лек автомобил?",
    a: `Да — от 3 февруари 2026 г. За леки автомобили до 3,5 т и къмпинг автомобили от категория М1 тя струва ${fmtEur(dnevna.priceEur)} (${fmtBgn(dnevna.priceBgn)}) по тарифата в сила от 1 август 2026 г.`,
  },
  {
    q: "Колко време важи еднодневната винетка?",
    a: "24 часа от началната дата и час, които изберете при покупката — не до полунощ. Активирана в 10:00 ч. на 5-и, тя важи до 09:59 ч. на 6-и.",
  },
  {
    q: "Еднодневна или уикенд винетка?",
    a: `Уикенд винетката (${fmtEur(uikend.priceEur)}) покрива от петък 12:00 ч. до неделя 23:59 ч. Пътувате ли само в събота или само в неделя и се връщате до 24 часа — еднодневната е с ${fmtEur(uikend.priceEur - dnevna.priceEur)} по-евтина.`,
  },
  {
    q: "Кога седмичната е по-изгодна от еднодневните?",
    a: `Още при два дни път: две еднодневни излизат ${fmtEur(dnevna.priceEur * 2)}, а <a href='/vinetka/ceni/sedmichna'>седмичната</a> — ${fmtEur(sedmichna.priceEur)} за 7 дни.`,
  },
  {
    q: "Пътувам само 20 км по магистрала — пак ли ми трябва винетка?",
    a: "Да — винетката се дължи за всяко движение по републикански път, независимо от разстоянието. Камерите засичат номера още при първото включване на магистралата.",
  },
];
---

<VignettePricePage
  priceSlug="dnevna"
  urlSlug="dnevna"
  title={`Еднодневна винетка — цена ${fmtEur(dnevna.priceEur)} и валидност 24 часа | По номер`}
  description={`Еднодневна винетка за лек автомобил: ${fmtEur(dnevna.priceEur)} (${fmtBgn(dnevna.priceBgn)}) от 1 август 2026 г., важи 24 часа от избрания начален час. Кога е по-изгодна от уикенд и седмична винетка.`}
  h1="Еднодневна винетка — цена и валидност"
  {faqItems}
>
  <p>
    <strong>Еднодневната винетка струва {fmtEur(dnevna.priceEur)} ({fmtBgn(dnevna.priceBgn)})</strong> и
    важи <strong>24 часа от началния час, който изберете</strong> — не до края на календарния ден. За
    леки автомобили я има от 3 февруари 2026 г.; преди това най-краткият вид беше уикенд винетката.
  </p>
  <h2>За кого е</h2>
  <ul>
    <li>Еднократно пътуване в делничен ден — до летището, до друг град по работа, до сервиз;</li>
    <li>Пътуване само в събота или само в неделя с връщане до 24 часа;</li>
    <li>Транзитно преминаване през страната за по-малко от денонощие.</li>
  </ul>
  <h2>Внимавайте с часа</h2>
  <p>
    Изберете начален час преди първото включване на магистрала или републикански път — ако тръгнете
    в 9:30 ч. с винетка от 10:00 ч., камерите ви засичат без винетка и следва
    <a href="/statii/globa-za-lipsvashta-vinetka">компенсаторна такса</a>. Два и повече дни път?
    <a href="/vinetka/ceni/sedmichna">Седмичната</a> излиза по-евтино. Преди да купите,
    <a href="/vinetka/proverka">проверете дали колата няма активна винетка</a>.
  </p>
</VignettePricePage>
