---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE, OFFICIAL_SOURCES } from "@/lib/site";

const title = `За проекта — кой и защо прави ${SITE.name}`;
const description =
  "Моята кола се прави от шофьор за шофьори: една проверка по номер вместо четири държавни сайта. Откъде идват данните, как печели сайтът и защо не искаме личните ви данни.";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  url: `${SITE.url}/za-proekta`,
  inLanguage: "bg",
  description,
};
---

<Base {title} {description} schema={[aboutSchema]}>
  <Breadcrumbs crumbs={[{ href: "/za-proekta", label: "За проекта" }]} />

  <section class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <h1 class="text-3xl sm:text-4xl">За проекта</h1>

    <div class="prose-app mt-6">
      <p>
        <strong>{SITE.name} се прави от шофьор за шофьори.</strong> Идеята се роди по класическия начин:
        петък следобед, кола пред блока, пътуване до Гърция на сутринта — и четири различни сайта, за да
        разбера дали ми е валидна винетката, гражданската и прегледът. Реших, че трябва да е една табела и
        един бутон.
      </p>

      <h2>Откъде идват данните</h2>
      <p>
        Не си измисляме нищо — всяка проверка стъпва на официалните регистри и винаги показваме кога е
        направена справката:
      </p>
      <ul>
        <li>
          <a href={OFFICIAL_SOURCES.bgtoll.checkUrl} rel="nofollow noopener">БГ ТОЛ / Национално тол управление</a>
          — електронни винетки;
        </li>
        <li>
          <a href={OFFICIAL_SOURCES.guaranteeFund.checkUrl} rel="nofollow noopener">Гаранционен фонд</a>
          — задължителна застраховка „Гражданска отговорност“;
        </li>
        <li>
          <a href={OFFICIAL_SOURCES.rta.checkUrl} rel="nofollow noopener">ИА „Автомобилна администрация“</a>
          — годишни технически прегледи;
        </li>
        <li>
          <a href={OFFICIAL_SOURCES.mvr.checkUrl} rel="nofollow noopener">МВР</a> — глоби и фишове (само насочваме, не четем).
        </li>
      </ul>
      <p>
        {SITE.name} е <strong>неофициален инструмент</strong>. При каквото и да е разминаване меродавни са
        официалните системи.
      </p>

      <h2>Какво не правим с данните ви</h2>
      <ul>
        <li>Не искаме регистрация, имейл или ЕГН за нито една проверка;</li>
        <li>Не съхраняваме регистрационни номера, свързани с личност;</li>
        <li>Не продаваме данни. Точка.</li>
      </ul>

      <h2>Как се издържа сайтът</h2>
      <p>
        Прозрачно: чрез реклама в статиите и партньорски връзки към места, откъдето може да купите винетка
        или застраховка. Партньорските връзки винаги са обозначени и никога не променят резултата от
        проверките — камерата на магистралата не се интересува от нашите партньорства, ние също.
      </p>

      <h2>Открихте грешка?</h2>
      <p>
        Пишете ни през <a href="/kontakti">страницата за контакт</a> — отговаряме бързо, а сигналите за
        неточни данни са с предимство.
      </p>
    </div>
  </section>
</Base>
