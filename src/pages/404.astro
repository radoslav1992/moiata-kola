---
import Base from "@/layouts/Base.astro";

const title = "Страницата не е намерена (404) | По номер";
const description = "Тази страница не съществува — но проверката на колата ви е на един клик.";
---

<Base {title} {description} noindex>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6">
    <p class="font-plate text-7xl font-semibold text-accent sm:text-8xl">404</p>
    <h1 class="mt-4 text-2xl sm:text-3xl">Тази страница не съществува</h1>
    <p class="mt-3 max-w-md text-ink-soft">
      Като уикенд винетка в петък сутрин — изглежда, че я има, но я няма. Проверете колата си вместо това:
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Провери всичко по номер</a>
      <a href="/vinetka/ceni" class="btn-secondary">Цени на винетки</a>
    </div>
  </section>
</Base>
