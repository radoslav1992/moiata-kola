---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/lib/site";
import meta from "@/data/statistika/meta.json";
import fleet from "@/data/statistika/fleet.json";
import age from "@/data/statistika/age.json";
import ytd from "@/data/statistika/ytd.json";

const fmt = (n: number) => n.toLocaleString("bg-BG");
const [year, monthNum] = meta.month.split("-");
const MONTHS = ["януари", "февруари", "март", "април", "май", "юни", "юли", "август", "септември", "октомври", "ноември", "декември"];
const asOf = `1 ${MONTHS[Number(monthNum) - 1]} ${year} г.`;

const title = `Автомобилна статистика на България ${year} — възраст, марки, горива | По номер`;
const description = `Колко коли има в България, на колко години са и какво карат българите: ${fmt(fleet.carsTotal)} леки автомобила, ${age.national.over15Share}% от тях по-стари от 15 години. По данни на МВР, обновявани всеки месец.`;

const carsUsedShare = Math.round((ytd.carsNewVsUsed.upotrebyavani / (ytd.carsNewVsUsed.novi + ytd.carsNewVsUsed.upotrebyavani)) * 100);
const oldest = age.regions.slice(0, 5);
const youngest = [...age.regions].reverse().slice(0, 5);

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: `Автомобилна статистика на България (към ${asOf})`,
  description,
  url: `${SITE.url}/statistika`,
  inLanguage: "bg",
  license: "https://data.egov.bg/",
  isBasedOn: meta.sourceUrl,
  creator: { "@id": `${SITE.url}/#organization` },
  temporalCoverage: meta.month,
};
---

<Base {title} {description} schema={[datasetSchema]} ogImagePath="/og-statistika.png">
  <Breadcrumbs crumbs={[{ href: "/statistika", label: "Статистика" }]} />

  <section class="mx-auto max-w-5xl px-4 pt-6 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl sm:text-4xl">Автомобилна статистика на България</h1>
      <p class="mt-3 text-ink-soft sm:text-lg">
        Какво кара България: данни от регистрите на МВР към {asOf}, обновявани всеки месец.
      </p>
    </div>
  </section>

  <!-- Големите числа -->
  <section id="avtopark" class="mx-auto max-w-5xl scroll-mt-20 px-4 pt-8 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-5 text-center">
        <p class="font-plate text-3xl font-semibold text-ink sm:text-4xl">{fmt(fleet.totals.allVehicles)}</p>
        <p class="mt-1 text-sm text-ink-soft">регистрирани превозни средства</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-plate text-3xl font-semibold text-ink sm:text-4xl">{fmt(fleet.carsTotal)}</p>
        <p class="mt-1 text-sm text-ink-soft">от тях леки автомобили</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-plate text-3xl font-semibold text-warn sm:text-4xl">{age.national.estMeanAge} г.</p>
        <p class="mt-1 text-sm text-ink-soft">средна възраст на леките (оценка)</p>
      </div>
      <div class="card p-5 text-center">
        <p class="font-plate text-3xl font-semibold text-warn sm:text-4xl">{age.national.over15Share}%</p>
        <p class="mt-1 text-sm text-ink-soft">от леките коли са по-стари от 15 години</p>
      </div>
    </div>
  </section>

  <!-- Горивен микс -->
  <section id="goriva" class="mx-auto max-w-3xl scroll-mt-20 px-4 pt-12 sm:px-6">
    <h2 class="text-2xl">С какво се движат леките автомобили</h2>
    <div class="card mt-5 space-y-3 p-6">
      {
        fleet.fuelMix.map((f) => (
          <div>
            <div class="flex items-baseline justify-between gap-3 text-sm">
              <span class="font-medium text-ink">{f.label}</span>
              <span class="text-ink-soft">
                {fmt(f.count)} · <strong class="text-ink">{f.share}%</strong>
              </span>
            </div>
            <div class="mt-1 h-2.5 overflow-hidden rounded-full bg-canvas">
              <div class="h-full rounded-full bg-accent" style={`width: ${Math.max(f.share, 0.4)}%`} />
            </div>
          </div>
        ))
      }
    </div>
    <p class="prose-app mt-4 text-sm">
      Дизелът все още движи почти половината автопарк, а чистите електромобили са
      {fmt(fleet.fuelMix.find((f) => f.label === "Електрически")?.count ?? 0)} —
      около {fleet.fuelMix.find((f) => f.label === "Електрически")?.share}% от леките коли.
    </p>
  </section>

  <!-- Възраст по области -->
  <section id="vazrast" class="mx-auto max-w-3xl scroll-mt-20 px-4 pt-12 sm:px-6">
    <h2 class="text-2xl">Къде са най-старите коли</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="card p-6">
        <p class="text-sm font-semibold text-ink">Най-стари коли</p>
        <table class="mt-3 w-full text-sm">
          <tbody>
            {oldest.map((r) => (
              <tr class="border-t border-line first:border-t-0">
                <td class="py-2 text-ink-soft">{r.region}</td>
                <td class="py-2 text-right font-medium text-ink">{r.estMeanAge} г.</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="card p-6">
        <p class="text-sm font-semibold text-ink">Най-нови коли</p>
        <table class="mt-3 w-full text-sm">
          <tbody>
            {youngest.map((r) => (
              <tr class="border-t border-line first:border-t-0">
                <td class="py-2 text-ink-soft">{r.region}</td>
                <td class="py-2 text-right font-medium text-ink">{r.estMeanAge} г.</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <details class="card mt-4 px-6 py-4">
      <summary class="cursor-pointer text-sm font-medium text-ink">Всички области — средна възраст и дял на колите над 15 г.</summary>
      <table class="mt-4 w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-ink-faint">
            <th class="pb-2 font-medium">Област</th>
            <th class="pb-2 text-right font-medium">Леки автомобили</th>
            <th class="pb-2 text-right font-medium">Средна възраст</th>
            <th class="pb-2 text-right font-medium">Над 15 г.</th>
          </tr>
        </thead>
        <tbody>
          {age.regions.map((r) => (
            <tr class="border-t border-line">
              <td class="py-2 text-ink-soft">{r.region}</td>
              <td class="py-2 text-right text-ink-soft">{fmt(r.total)}</td>
              <td class="py-2 text-right font-medium text-ink">{r.estMeanAge} г.</td>
              <td class="py-2 text-right text-ink-soft">{r.over15Share}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </section>

  <!-- Регистрации от началото на годината -->
  <section id="registracii" class="mx-auto max-w-3xl scroll-mt-20 px-4 pt-12 sm:px-6">
    <h2 class="text-2xl">Новите регистрации през {year} г.</h2>
    <p class="prose-app mt-3">
      От началото на годината до {asOf} в България са регистрирани за първи път
      <strong>{fmt(ytd.newVsUsed.novi + ytd.newVsUsed.upotrebyavani)}</strong> превозни средства.
      При леките автомобили вносът на употребявани продължава да доминира:
      <strong>{carsUsedShare}% са употребявани</strong> ({fmt(ytd.carsNewVsUsed.upotrebyavani)} коли срещу
      {fmt(ytd.carsNewVsUsed.novi)} чисто нови).
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div id="marki" class="card scroll-mt-20 p-6">
        <p class="text-sm font-semibold text-ink">Топ 10 марки при новите коли</p>
        <table class="mt-3 w-full text-sm">
          <tbody>
            {ytd.topNewCarBrands.map((b, i) => (
              <tr class="border-t border-line first:border-t-0">
                <td class="py-1.5 pr-2 text-xs text-ink-faint">{i + 1}</td>
                <td class="py-1.5 text-ink-soft">{b.brand}</td>
                <td class="py-1.5 text-right font-medium text-ink">{fmt(b.count)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="card p-6">
        <p class="text-sm font-semibold text-ink">Хибридите набират скорост</p>
        <p class="mt-3 font-plate text-4xl font-semibold text-ok">{fmt(ytd.hybrids.total)}</p>
        <p class="mt-1 text-sm text-ink-soft">
          хибридни автомобила са регистрирани за първи път от началото на годината —
          {Math.round((ytd.hybrids.total / (ytd.newVsUsed.novi + ytd.newVsUsed.upotrebyavani)) * 100)}% от всички
          първоначални регистрации.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          От тях {fmt(ytd.hybrids.byClass["NOVC-HEV"] ?? 0)} са самозареждащи се (HEV), а
          {fmt(ytd.hybrids.byClass["OVC-HEV"] ?? 0)} — plug-in (PHEV); останалите са без посочен клас в регистъра.
        </p>
      </div>
    </div>
  </section>

  <!-- Методика -->
  <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
    <div class="card border-l-4 border-l-accent p-6 text-sm leading-relaxed text-ink-soft">
      <p class="font-semibold text-ink">Откъде са данните и как смятаме</p>
      <ul class="mt-2 list-disc space-y-1.5 pl-5">
        <li>
          Източник: <a href={meta.sourceUrl} rel="nofollow noopener" class="font-medium text-accent underline decoration-accent/30 underline-offset-2">отворените данни на МВР</a>
          за регистрираните превозни средства, актуални към {asOf}. Обновяваме страницата всеки месец, щом
          МВР публикува новите данни.
        </li>
        <li>
          „Средна възраст“ е <strong>оценка</strong>: МВР дава възрастта в групи (0–5, 6–10, 11–15, 16–20,
          над 20 г.), затова смятаме средната от средите на групите, а за „над 20“ приемаме 25 г. Делът на
          колите над 15 години е точно число, без допускания.
        </li>
        <li>
          Броим само леки автомобили (категория M1) за възрастта и горивата; „регистрации“ означава първоначална
          регистрация в България — препродажбите и пререгистрациите не са включени.
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="card flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="text-xl">А вашата кола?</h2>
        <p class="mt-1 text-sm text-ink-soft">Проверете винетка, Гражданска отговорност и ГТП за 10 секунди.</p>
      </div>
      <a href="/" class="btn-primary shrink-0">Провери по номер</a>
    </div>
  </section>
</Base>
