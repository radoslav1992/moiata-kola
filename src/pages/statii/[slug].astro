---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Faq from "@/components/Faq.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "@/lib/site";

export async function getStaticPaths() {
  const articles = await getCollection("statii");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, faq, tool, toolLabel, category } = article.data;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: "bg",
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Organization", name: SITE.name, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: `${SITE.url}/statii/${article.id}`,
};

const related = (await getCollection("statii"))
  .filter((a) => a.id !== article.id && a.data.category === category)
  .slice(0, 2);
---

<Base
  title={`${title} | ${SITE.name}`}
  {description}
  schema={[articleSchema]}
  ogType="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={(updatedDate ?? pubDate).toISOString()}
>
  <Breadcrumbs crumbs={[{ href: "/statii", label: "Статии" }, { label: title }]} />

  <article class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <header>
      <h1 class="text-3xl sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-ink-faint">
        Обновена на
        <time datetime={(updatedDate ?? pubDate).toISOString()}>
          {(updatedDate ?? pubDate).toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric" })}
        </time>
      </p>
    </header>

    <div class="prose-app mt-6">
      <Content />
    </div>

    <aside class="card mt-10 flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-7">
      <div>
        <p class="text-lg font-semibold">Проверете за 10 секунди</p>
        <p class="mt-1 text-sm text-ink-soft">Безплатно, по регистрационен номер, без регистрация.</p>
      </div>
      <a href={tool} class="btn-primary shrink-0">{toolLabel}</a>
    </aside>
  </article>

  {
    faq.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
        <Faq items={faq} />
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <h2 class="text-xl font-semibold">Четете още</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((a) => (
            <a href={`/statii/${a.id}`} class="card group p-5 transition-colors hover:border-accent">
              <p class="font-semibold group-hover:text-accent">{a.data.title}</p>
              <p class="mt-2 line-clamp-2 text-sm text-ink-soft">{a.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>
