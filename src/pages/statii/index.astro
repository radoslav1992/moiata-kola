---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getCollection } from "astro:content";

const title = "Статии и ръководства за всяка проверка на колата | Моята кола";
const description =
  "Практични ръководства за български шофьори: винетки и глоби, ГТП, Гражданска отговорност, покупка на кола втора ръка. Кратък отговор в първите две изречения, после детайлите.";

const CATEGORIES: Record<string, string> = {
  vinetki: "Винетки",
  gtp: "ГТП",
  grazhdanska: "Гражданска отговорност",
  globi: "Глоби",
  sobstvenost: "Собственост",
};

const articles = (await getCollection("statii")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<Base {title} {description}>
  <Breadcrumbs crumbs={[{ href: "/statii", label: "Статии" }]} />

  <section class="mx-auto max-w-5xl px-4 pt-6 sm:px-6">
    <h1 class="text-3xl sm:text-4xl">Статии и ръководства</h1>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Без увъртане: отговорът е в първите две изречения, детайлите — след него. Всяка статия води към
      безплатна проверка.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        articles.map((a) => (
          <a href={`/statii/${a.id}`} class="card group flex flex-col p-6 transition-colors hover:border-accent">
            <span class="text-xs font-semibold tracking-wide text-accent uppercase">
              {CATEGORIES[a.data.category]}
            </span>
            <h2 class="mt-2 text-lg font-semibold group-hover:text-accent">{a.data.title}</h2>
            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">{a.data.description}</p>
            <time datetime={a.data.pubDate.toISOString()} class="mt-auto pt-4 text-xs text-ink-faint">
              {(a.data.updatedDate ?? a.data.pubDate).toLocaleDateString("bg-BG", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </time>
          </a>
        ))
      }
    </div>
  </section>
</Base>
