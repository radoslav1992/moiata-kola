---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Faq from "@/components/Faq.astro";

const title = "ГТП цена 2026 — колко струва годишният технически преглед | По номер";
const description =
  "Колко струва ГТП през 2026 г.: ориентировъчно 30–60 € (60–120 лв.) за лек автомобил според града и пункта. Какво включва прегледът, какви документи трябват и как да платите по-малко.";

const faqItems = [
  {
    q: "Колко струва ГТП за лек автомобил?",
    a: "Цената не е фиксирана от държавата — определя я всеки пункт. През 2026 г. за лек автомобил се движи ориентировъчно между 30 € и 60 € (60–120 лв.), като в София и големите градове е по-високата част от диапазона.",
  },
  {
    q: "Какви документи трябват за ГТП?",
    a: "Свидетелство за регистрация на МПС (поне малкия талон), валидна Гражданска отговорност и платен данък МПС за текущата година. Без платен данък пунктът няма право да извърши прегледа.",
  },
  {
    q: "Колко време отнема прегледът?",
    a: "Самият преглед е 20–40 минути. В края на месеца и преди празници опашките са най-големи — повечето пунктове вече приемат запазване на час по телефона.",
  },
  {
    q: "Какво се проверява на ГТП?",
    a: "Спирачна система, окачване, кормилна уредба, светлини, гуми, емисии на отработени газове, и видими течове. Най-честите причини за „късане“ са изгорели крушки, износени гуми и спирачки с неравномерно действие — все неща, които може да проверите предварително.",
  },
  {
    q: "Има ли отстъпки за ГТП?",
    a: "Много пунктове дават отстъпка при онлайн записване, в делнични сутрини или в комбинация със смяна на масло/гуми в същия сервиз. Питайте — разликата стига 20%.",
  },
];
---

<Base {title} {description}>
  <Breadcrumbs
    crumbs={[
      { href: "/gtp/proverka", label: "ГТП" },
      { href: "/gtp/cena", label: "ГТП цена" },
    ]}
  />

  <section class="mx-auto max-w-3xl px-4 pt-6 sm:px-6">
    <h1 class="text-center text-3xl sm:text-4xl">Колко струва ГТП през 2026 г.</h1>

    <div class="card mx-auto mt-7 flex max-w-md flex-col items-center gap-1 p-7 text-center">
      <p class="text-sm font-medium text-ink-soft">Лек автомобил — ориентировъчно</p>
      <p class="font-plate text-5xl font-semibold text-accent sm:text-6xl">30–60&nbsp;€</p>
      <p class="text-ink-soft">60–120 лв. според града и пункта</p>
    </div>

    <div class="prose-app mt-8">
      <p>
        <strong>Цената на годишния технически преглед не е фиксирана</strong> — всеки лицензиран пункт я
        определя сам. Затова разликите между съседни пунктове стигат 50%. Преди да отидете:
      </p>
      <ul>
        <li>Обадете се на 2–3 пункта наблизо — цената се казва по телефона;</li>
        <li>Питайте за отстъпка при онлайн/телефонно записване;</li>
        <li>Избягвайте последната седмица на месеца — опашки и никакво желание за отстъпки.</li>
      </ul>

      <h2>Какво ви трябва</h2>
      <ol>
        <li>Свидетелство за регистрация (малък талон);</li>
        <li>Валидна <a href="/grazhdanska-otgovornost/proverka">Гражданска отговорност</a>;</li>
        <li>Платен данък МПС за годината — носете бележката или разчитайте на електронната проверка на пункта.</li>
      </ol>

      <h2>Преди да тръгнете към пункта</h2>
      <p>
        Първо <a href="/gtp/proverka">проверете докога е валиден сегашният ви ГТП</a> — минете ли прегледа
        в същия месец, в който изтича, не губите нито ден от срока.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <Faq items={faqItems} />
  </section>
</Base>
