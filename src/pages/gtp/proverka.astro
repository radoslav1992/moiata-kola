---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PlateCheck from "@/components/PlateCheck.astro";
import Faq from "@/components/Faq.astro";
import AdSlot from "@/components/AdSlot.astro";
import { SITE, OFFICIAL_SOURCES } from "@/lib/site";

const title = `Проверка на ГТП по номер — валиден ли е техническият преглед | ${SITE.name}`;
const description =
  "Проверка на ГТП онлайн по регистрационен номер: до коя дата е валиден годишният технически преглед на МПС. Безплатна справка в системата на ИААА — без регистрация.";

const faqItems = [
  {
    q: "Как да проверя докога е валиден ГТП на колата?",
    a: "Въведете регистрационния номер по-горе, препишете кода за сигурност от картинката — и резултатът се показва направо тук. Данните идват от системата на ИА „Автомобилна администрация“ (ИААА); кодът е нейно изискване и се решава от вас.",
  },
  {
    q: "Колко често се минава годишен технически преглед?",
    a: "Леките автомобили минават първи преглед 3 години след първата регистрация, втори — след още 2 години, а след това всяка година.",
  },
  {
    q: "Каква е глобата за изтекъл ГТП?",
    a: "Глобата за управление на автомобил без валиден технически преглед е 50 лв. (25,56 €) с фиш, а при проверка колата може да бъде спряна от движение до преминаване на преглед. Застрахователи може да откажат и плащане по каско при ПТП с изтекъл ГТП.",
  },
  {
    q: "Какви документи трябват за ГТП?",
    a: "Свидетелство за регистрация на МПС (голям и малък талон или само малък), валидна Гражданска отговорност и платен данък МПС. Цените и пунктовете вижте на страницата „ГТП цена“.",
  },
  {
    q: "Може ли да мина ГТП по-рано от крайната дата?",
    a: "Да, по всяко време. Но новият срок е една година от датата на новия преглед — не от старата крайна дата. Минете ли месец по-рано, този месец на практика се губи. Затова повечето хора минават преглед в последните дни преди изтичането.",
  },
  {
    q: "Мога ли да проверя ГТП на чужда кола?",
    a: "Да. Справката изисква само регистрационен номер, без данни за собственика. Направете я задължително преди <a href='/statii/kupuvam-kola-vtora-ruka-checklist'>покупка на кола втора ръка</a> — изтекъл преглед често значи и скрит технически проблем.",
  },
  {
    q: "Проверката показва изтекъл ГТП, а на стъклото има валиден стикер. Кое е вярно?",
    a: "Меродавен е регистърът на ИААА — при проверка на пътя полицията гледа него, не стикера. Ако току-що сте минали преглед, изчакайте до края на деня. Ако разминаването остане, потърсете пункта, в който сте минали прегледа — той трябва да го е отразил в системата.",
  },
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "ГТП проверка по регистрационен номер",
  url: `${SITE.url}/gtp/proverka`,
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  inLanguage: "bg",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  description,
};
---

<Base {title} {description} schema={[appSchema]}>
  <Breadcrumbs crumbs={[{ href: "/gtp/proverka", label: "ГТП проверка" }]} />

  <section class="mx-auto max-w-5xl px-4 pt-6 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl sm:text-4xl">Проверка на ГТП по номер</h1>
      <p class="mt-3 text-ink-soft sm:text-lg">
        Валиден ли е годишният технически преглед и до коя дата — справка в регистъра на ИААА за секунди.
      </p>
    </div>
    <div class="mx-auto mt-7 max-w-2xl">
      <PlateCheck checks={["inspection"]} buttonLabel="Провери ГТП" />
      <p class="mt-3 text-center text-xs text-ink-faint">
        Системата на ИААА изисква код за сигурност — затова виждате картинка с код.
        Кодът се решава от вас; ние само пренасяме заявката до официалната система.
      </p>
      <AdSlot format="rectangle" afterCheck class="mt-8" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="prose-app">
      <h2>Как се прави проверката на ГТП</h2>
      <ol>
        <li>Въведете регистрационния номер точно както е на табелата, напр. СВ 1234 АВ;</li>
        <li>Препишете кода за сигурност от картинката — изискване на системата на ИААА;</li>
        <li>Виждате дали колата има валиден технически преглед и до коя дата важи.</li>
      </ol>
      <p>
        Справката за ГТП е безплатна и публична: не трябват ЕГН, талон или данни за собственика. Данните
        идват в реално време от регистъра на
        <a href={OFFICIAL_SOURCES.rta.checkUrl} rel="nofollow noopener">ИА „Автомобилна администрация“</a> —
        същия, по който проверява и полицията на пътя. Разликата е, че тук с един номер виждате и
        <a href="/grazhdanska-otgovornost/proverka">Гражданската отговорност</a>, и
        <a href="/vinetka/proverka">винетката</a>.
      </p>

      <h2>Какво е ГТП и защо срокът е важен</h2>
      <p>
        Годишният технически преглед (ГТП) удостоверява, че автомобилът е технически изправен и може да се
        движи по пътищата. С изтекъл преглед рискувате глоба, спиране от движение и проблеми със
        застраховките — затова проверката на техническия преглед си струва поне веднъж годишно, а и преди
        всяко по-дълго пътуване.
      </p>

      <h2>Валидност на годишния технически преглед</h2>
      <p>За леките автомобили срокът зависи от възрастта на колата:</p>
      <ul>
        <li><strong>Нов автомобил:</strong> първи преглед 3 години след първата регистрация;</li>
        <li><strong>След първия:</strong> втори преглед след още 2 години;</li>
        <li><strong>След това:</strong> всяка година, до същата дата.</li>
      </ul>
      <p>
        Прегледът важи до датата, записана в регистъра и на знака в долния десен ъгъл на предното стъкло.
        Минете ли го по-рано, новият срок тече от деня на новия преглед — не от старата крайна дата.
      </p>

      <h2>ГТП е изтекъл — какво да направите</h2>
      <ul>
        <li><strong>Минете преглед възможно най-скоро</strong> — глобата е 50 лв. (25,56 €), а при проверка колата може да бъде спряна от движение;</li>
        <li><strong>Проверете документите:</strong> на пункта трябват талон, <a href="/grazhdanska-otgovornost/proverka">валидна Гражданска отговорност</a> и платен данък МПС — без тях прегледът не се прави;</li>
        <li><strong>Изберете пункт и цена</strong> — прегледът за лек автомобил е около 30–60 €, цените по градове са на страницата <a href="/gtp/cena">ГТП цена 2026</a>.</li>
      </ul>

      <h2>Кога е добре да проверите ГТП</h2>
      <ul>
        <li>Преди <a href="/statii/kupuvam-kola-vtora-ruka-checklist">покупка на кола втора ръка</a>;</li>
        <li>Когато карате чужда, служебна или наета кола;</li>
        <li>Ако не помните датата и стикерът на стъклото е нечетлив или липсва;</li>
        <li>Преди по-дълго пътуване — при изтекъл ГТП застрахователят може да откаже плащане по „Каско“.</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-4 sm:px-6">
    <Faq items={faqItems} />
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="card flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="text-xl">ГТП изтича скоро?</h2>
        <p class="mt-1 text-sm text-ink-soft">Вижте колко струва прегледът и какви документи са нужни.</p>
      </div>
      <a href="/gtp/cena" class="btn-primary shrink-0">ГТП цени и документи</a>
    </div>
  </section>
</Base>
